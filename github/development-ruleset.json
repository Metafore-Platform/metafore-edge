{
  "name": "development",
  "target": "branch",
  "enforcement": "active",
  "conditions": { "ref_name": { "include": ["refs/heads/development"], "exclude": [] } },
  "bypass_actors": [],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    { "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          { "context": "guard" }, { "context": "test" }, { "context": "fhir-it" },
          { "context": "dialects (mysql)" }, { "context": "dialects (mariadb)" },
          { "context": "mtls" }, { "context": "image" }
        ]
      } }
  ]
}
